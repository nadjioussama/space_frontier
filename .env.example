# Copy to .env and edit. docker-compose reads this file.

# NASA API — get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Django
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Postgres
POSTGRES_DB=nse
POSTGRES_USER=nse
POSTGRES_PASSWORD=nse
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Sentry (Phase 3) — leave empty to disable
SENTRY_DSN=

# Frontend -> backend
NEXT_PUBLIC_API_BASE=http://localhost:8000
