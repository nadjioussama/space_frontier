# Copy to .env and edit. docker-compose reads this file.

# NASA API — get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Django
DJANGO_SECRET_KEY=dev-only-unsecure-key-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=config.settings.dev

# Postgres
POSTGRES_DB=nse
POSTGRES_USER=nse
POSTGRES_PASSWORD=nse
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (also used as Celery broker)
REDIS_URL=redis://redis:6379/0

# Slack alerts (optional — leave empty to disable)
SLACK_WEBHOOK_URL=

# Sentry error tracking (optional — leave empty to disable)
SENTRY_DSN=

# Frontend -> backend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Production-only (not needed for local dev) ---
# AWS_REGION=us-east-1
# MEDIA_BUCKET=nse-prod-media
# POSTGRES_REPLICA_HOST=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
